<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Chezmoi template for the optional direct LaunchAgent supervisor.
  Render this file before installing it; do not put the bridge token here.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stavrobot.imcp</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir }}/Developer/stavrobot-imcp/.venv/bin/python</string>
    <string>{{ .chezmoi.homeDir }}/Developer/stavrobot-imcp/bridge/server.py</string>
    <string>--bind</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8766</string>
    <string>--path</string>
    <string>/bridge</string>
    <string>--token-file</string>
    <string>{{ .chezmoi.homeDir }}/.config/imcp-bridge.token</string>
    <string>--allowlist-file</string>
    <string>{{ .chezmoi.homeDir }}/.config/imcp-bridge-tools.json</string>
    <string>--call-timeout</string>
    <string>10</string>
  </array>

  <key>WorkingDirectory</key>
  <string>{{ .chezmoi.homeDir }}/Developer/stavrobot-imcp</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>{{ .chezmoi.homeDir }}</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>ProcessType</key>
  <string>Interactive</string>

  <key>RunAtLoad</key>
  <true/>

  <!--
    Deliberately do not retry automatically: a port collision would otherwise
    produce a launchd/log loop. Preflight the fixed port before loading.
  -->
  <key>KeepAlive</key>
  <false/>

  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir }}/Library/Logs/Stavrobot/imcp-bridge.out.log</string>

  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/Library/Logs/Stavrobot/imcp-bridge.err.log</string>
</dict>
</plist>
